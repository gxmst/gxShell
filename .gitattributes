# Normalize line endings: check in as LF, check out native.
# Fixes the phantom "modified" files (pure CRLF/LF churn) in git status.
* text=auto

# Source and text files are always LF in the repository.
*.go        text eol=lf
*.mod       text eol=lf
*.sum       text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.mjs       text eol=lf
*.jsx       text eol=lf
*.json      text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.txt       text eol=lf
*.sh        text eol=lf

# Windows-specific scripts stay CRLF.
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Binary assets: never touch.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.woff      binary
*.woff2     binary
*.exe       binary
*.dat       binary
